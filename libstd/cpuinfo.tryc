    ) endasm


def has_avx() -> int:
    /*
    * Controlla se la CPU supporta AVX (il sistema operativo potrebbe comunque
    * non averlo abilitato). Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_AVX
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_avx2() -> int:
    /*
    * Controlla se la CPU supporta AVX2 (il sistema operativo potrebbe
    * comunque non averlo abilitato). Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_EXT_FEATURES
        xor ecx, ecx
        cpuid
        and ebx, CPUID_LEAF7_EBX_AVX2
        cmp ebx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_avx512f() -> int:
    /*
    * Controlla se la CPU supporta AVX-512 Foundation. Su aarch64
    * restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_EXT_FEATURES
        xor ecx, ecx
        cpuid
        and ebx, CPUID_LEAF7_EBX_AVX512F
        cmp ebx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_aes() -> int:
    /*
    * Controlla se la CPU ha le istruzioni AES (AES-NI su x86_64).
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_AES
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_rdrand() -> int:
    /*
    * Controlla se la CPU ha un generatore di numeri casuali in hardware:
    * RDRAND su x86_64, RNDR su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_RDRAND
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_popcnt() -> int:
    /*
    * Controlla se la CPU conta i bit di una parola in un'istruzione: POPCNT
    * su x86_64, CNT di NEON su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_POPCNT
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_fma() -> int:
    /*
    * Controlla se la CPU ha la moltiplicazione e somma fuse: FMA3 su x86_64,
    * FMADD (virgola mobile di base) su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_FMA
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_mmx() -> int:
    /*
    * Controlla se la CPU supporta MMX. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and edx, CPUID_EDX_MMX
        cmp edx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def is_hypervisor() -> int:
    /*
    * Controlla se il programma gira in una macchina virtuale (il bit
    * hypervisor di CPUID). Su aarch64 non si puo' sapere e restituisce 0.
    * return: 1 in una macchina virtuale, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_HYPERVISOR
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def rdmsr(msr: int) -> int:
    /*
    * Legge un registro MSR con l'istruzione rdmsr. Solo x86_64 e solo in
    * ring 0: in un processo normale e' un fault.
    * argomenti:
    *   msr: il numero del registro
    * return: il valore
    */
    asminline(
        mov ecx, edi
        rdmsr

        shl rdx, 32
        or rax, rdx
    ) endasm


def wrmsr(msr: int, value: int) -> None:
    /*
    * Scrive un registro MSR con l'istruzione wrmsr. Solo x86_64 e solo in
    * ring 0.
    * argomenti:
    *   msr: il numero del registro
    *   value: il valore
    * return: nessuno (procedura)
    */
    asminline(
        mov ecx, edi
        mov eax, esi
        mov edx, esi
        shr rdx, 32
        wrmsr
    ) endasm


// le estensioni di aarch64: su x86_64 non ci sono

def has_neon() -> int:
    /*
    * Controlla se la CPU ha NEON (AdvSIMD), i registri vettoriali da 128
    * bit. Su x86_64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    return 0


def has_sve() -> int:
    /*
    * Controlla se la CPU ha SVE, i vettori a lunghezza variabile. Su x86_64
    * restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    return 0


def has_sve2() -> int:
    /*
    * Controlla se la CPU ha SVE2. Su x86_64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    return 0


#endif // ifdef __x86_64__


#ifdef __aarch64__

// per aarch64
/*
* registri: x0 - x30 (tutti a 64 bit)
* |       x0        |
* |        |   w0   |
* +-----------------+
*
* Registro	 | Uso
* x0-x7	     | argomenti / valori di ritorno
* x8         | syscall numer su linux
* x9-x15     | registri scratch
* x16-x17	 | intra-procedure-call temporaries
* x18        | platform register, da evitare genericamente
* x19-x28    | callee-saved
* x29        | frame-pointer (rbp)
* x30        | link register (lr) 
* sp         | stack pointer (rsp)
*
I valori interi si passano con davanti #
mov x0, #11
add <destination>, <source1>, <source2>
eor x0, x0, x0      ; equivalente xor
add x0, x2, #22
cpuid    | mrs
syscall  | svc #0
call     | bl
b        | jmp
xzr/wzr	zero register
syscall  num  | ret |
x86_64   rax  | rax | rdi     rsi      rdx   r10   r8      r9 
arm64	 x8	  | x0  |  x0  	  x1	   x2 	 x3	   x4	   x5
sostituto di sse4_2 e' NEON (reg 128 bit, v<num>)
sostituto di AVX2 e' SVE2 (reg)
*/


/*
*   aarch64, Linux: al posto di CPUID ci sono i registri ID di sistema,
*   letti con 'mrs'. Da user space li emula il kernel (HWCAP_CPUID, da
*   Linux 4.11): MIDR_EL1 e i campi delle feature arrivano veri, gli
*   altri campi a 0. CTR_EL0 invece si legge direttamente.
*/

#ifndef SYS_SCHED_GETAFFINITY
#define SYS_SCHED_GETAFFINITY 123
#endif

/* bit di partenza dei campi dei registri ID, larghi 4 bit; 15 = assente */

#ifndef ID_AA64PFR0_FP
#define ID_AA64PFR0_FP 16
#endif

#ifndef ID_AA64PFR0_ADVSIMD
// NEON
#define ID_AA64PFR0_ADVSIMD 20
#endif

#ifndef ID_AA64PFR0_SVE
// 0 = assente
#define ID_AA64PFR0_SVE 32
#endif

#ifndef ID_AA64ISAR0_AES
// 0 = assente
#define ID_AA64ISAR0_AES 4
#endif

#ifndef ID_AA64ISAR0_RNDR
// 0 = assente
#define ID_AA64ISAR0_RNDR 60
#endif

#ifndef ID_AA64ZFR0_SVEVER
// 0 = SVE, 1 = SVE2
#define ID_AA64ZFR0_SVEVER 0
#endif

#ifndef ID_FIELD_ABSENT
#define ID_FIELD_ABSENT 15
#endif


def read_midr_el1() -> long:
    /*
    * Legge MIDR_EL1, che identifica il core: Implementer [31:24], Variant
    * [23:20], Architecture [19:16], PartNum [15:4], Revision [3:0]. Solo
    * aarch64.
    * return: il registro
    */
    asminline(
        mrs x0, MIDR_EL1
    ) endasm


def read_ctr_el0() -> long:
    /*
    * Legge CTR_EL0, la geometria delle cache: DminLine [19:16] e' il log2
    * della linea dati piu' piccola, in parole da 4 byte. Solo aarch64.
    * return: il registro
    */
    asminline(
        mrs x0, CTR_EL0
    ) endasm


def read_id_aa64pfr0_el1() -> long:
    /*
    * Legge ID_AA64PFR0_EL1: virgola mobile, NEON (AdvSIMD), SVE. Solo
    * aarch64.
    * return: il registro
    */
    asminline(
        mrs x0, ID_AA64PFR0_EL1
    ) endasm


def read_id_aa64isar0_el1() -> long:
    /*
    * Legge ID_AA64ISAR0_EL1: le istruzioni opzionali (AES, SHA, CRC32,
    * atomiche, RNDR...). Solo aarch64.
    * return: il registro
    */
    asminline(
        mrs x0, ID_AA64ISAR0_EL1
    ) endasm


def read_id_aa64zfr0_el1() -> long:
    /*
    * Legge ID_AA64ZFR0_EL1, la versione di SVE. Solo aarch64.
    * return: il registro
    */
    asminline(
        mrs x0, S3_0_C0_C4_4
    ) endasm


def id_reg_field(reg: long, shift: int, width: int) -> int:
    /*
    * Estrae un campo di bit da un registro.
    * argomenti:
    *   reg: il registro
    *   shift: il primo bit del campo
    *   width: quanti bit
    * return: il valore del campo
    */
    asminline(
        lsr x0, x0, x1
        mov x3, #1
        lsl x3, x3, x2
        sub x3, x3, #1
        and x0, x0, x3
    ) endasm


def cpu_family() -> int:
    /*
    * Restituisce la famiglia della CPU: su x86_64 la family di CPUID (con
    * la extended family), su aarch64 il codice di chi ha progettato il core
    * (MIDR_EL1.Implementer: 65 ARM, 81 Qualcomm, 97 Apple...).
    * return: il numero
    */
    return id_reg_field(read_midr_el1(), 24, 8)


def cpu_model() -> int:
    /*
    * Restituisce il modello della CPU: su x86_64 il model di CPUID (con
    * l'extended model), su aarch64 il part number del core (MIDR_EL1.PartNum,
    * es. 3336 per Cortex-A72).
    * return: il numero
    */
    return id_reg_field(read_midr_el1(), 4, 12)


def cpu_stepping() -> int:
    /*
    * Restituisce la revisione della CPU: su x86_64 lo stepping di CPUID, su
    * aarch64 la revisione rNpM del core come N * 16 + M.
    * return: il numero
    */
    midr = read_midr_el1()
    return id_reg_field(midr, 20, 4) * 16 + id_reg_field(midr, 0, 4)


/*
* si usano appositamente dei nomi lunghi
* in modo che non possano essere visti esternamente
*/
_dispatcher_implementer_cpuinfo = {
    65: "ARM",
    66: "Broadcom",
    67: "Cavium",
    70: "Fujitsu",
    72: "HiSilicon",
    78: "NVIDIA",
    80: "APM",
    81: "Qualcomm",
    83: "Samsung",
    86: "Marvell",
    97: "Apple",
    109: "Microsoft",
    112: "Phytium",
    192: "Ampere"
}

_dispatcher_arm_core_name_cpuinfo = {
    3331: "Cortex-A53",
    3332: "ortex-A35",
    3333: "Cortex-A55",
    3335: "Cortex-A57",
    3336: "Cortex-A72",
    3337: "Cortex-A73",
    3338: "Cortex-A75",
    3339: "Cortex-A76",
    3340: "Neoverse-N1",
    3341: "Cortex-A77",
    3392: "Neoverse-V1",
    3393: "Cortex-A78",
    3396: "Cortex-X1",
    3398: "Cortex-A510",
    3399: "Cortex-A710",
    3400: "Cortex-X2",
    3401: "Neoverse-N2",
    3405: "Cortex-A715",
    3406: "Cortex-X3",
    3407: "Neoverse-V2",
    3456: "Cortex-A520",
    3458: "Cortex-A720",
    3458: "Cortex-X4",
}


def cpu_vendor() -> str:
    /*
    * Restituisce il produttore della CPU: su x86_64 la stringa di CPUID (es.
    * "GenuineIntel", "AuthenticAMD"), su aarch64 chi ha progettato il core
    * (es. "ARM", "Qualcomm", "Apple").
    * return: il nome; su aarch64, con un codice sconosciuto, "Unknown
    *   implementer. Num " seguito dal codice
    */
    implementer = cpu_family()
    if idict_has(_dispatcher_implementer_cpuinfo, implementer):
        return idict_get(_dispatcher_implementer_cpuinfo, implementer)
    return "Unknown implementer. Num " + itoa(implementer)


def arm_core_name(part: int) -> str:
    /*
    * Restituisce il nome di un core progettato da ARM (implementer 65).
    * Solo aarch64.
    * argomenti:
    *   part: il part number, da cpu_model
    * return: il nome, es. "Cortex-A72"; "" se non e' nell'elenco
    */
    if idict_has(_dispatcher_arm_core_name_cpuinfo, part):
        return idict_get(_dispatcher_arm_core_name_cpuinfo, part)
    return ""


def cpu_brand() -> str:
    /*
    * Restituisce il nome completo della CPU: su x86_64 la stringa di CPUID
    * (es. "Intel(R) Core(TM) i7-9700K CPU @ 3.60GHz", anche con spazi finali),
    * su aarch64 produttore e core (es. "ARM Cortex-A72", "Qualcomm part
    * 0x804").
    * return: il nome
    */
    vendor = cpu_vendor()
    part = cpu_model()
    if cpu_family() == 65:
        name = arm_core_name(part)
        if name != "":
            return vendor + " " + name

    return vendor + " part 0x" + long_to_hex(part as long, 3)


def cpu_cache_line_size() -> int:
    /*
    * Restituisce la dimensione di una linea di cache (su aarch64 la linea
    * dati piu' piccola).
    * return: i byte
    */
    return 4 << id_reg_field(read_ctr_el0(), 16, 4)


def physical_address_bits() -> int:
    /*
    * Restituisce quanti bit usa la CPU per gli indirizzi fisici (2^n byte
    * di memoria indirizzabile). Su aarch64 il dato non si legge da user
    * space.
    * return: i bit, -1 su aarch64
    */
    return -1


def virtual_address_bits() -> int:
    /*
    * Restituisce quanti bit usa la CPU per gli indirizzi virtuali. Su
    * aarch64 il dato non si legge da user space.
    * return: i bit, -1 su aarch64
    */
    return -1


def logical_cpu_count() -> int:
    /*
    * Restituisce quante CPU logiche puo' usare il processo
    * (sched_getaffinity).
    * return: il numero di CPU
    */
    asminline(
        mov x0, #128
        bl rt_alloc
        mov x19, x0
        mov x0, #0
        mov x1, #128
        mov x2, x19
        mov x8, #SYS_SCHED_GETAFFINITY
        svc #0

        mov x0, #0
        mov x3, #0
        .byte_loop:
            cmp x3, #128
            b.ge .done
            ldrb w4, [x19, x3]
            .count_bits:
                cbz x4, .next_byte
                sub x5, x4, #1
                and x4, x4, x5
                add x0, x0, #1
                b .count_bits
            .next_byte:
            add x3, x3, #1
            b .byte_loop
        .done:
    ) endasm


def is_hypervisor() -> int:
    /*
    * Controlla se il programma gira in una macchina virtuale (il bit
    * hypervisor di CPUID). Su aarch64 non si puo' sapere e restituisce 0.
    * return: 1 in una macchina virtuale, 0 altrimenti
    */
    return 0


def has_neon() -> int:
    /*
    * Controlla se la CPU ha NEON (AdvSIMD), i registri vettoriali da 128
    * bit. Su x86_64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    if id_reg_field(read_id_aa64pfr0_el1(), ID_AA64PFR0_ADVSIMD, 4) == ID_FIELD_ABSENT:
        return 0
    return 1


def has_sve() -> int:
    /*
    * Controlla se la CPU ha SVE, i vettori a lunghezza variabile. Su x86_64
    * restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    if id_reg_field(read_id_aa64pfr0_el1(), ID_AA64PFR0_SVE, 4) == 0:
        return 0
    return 1


def has_sve2() -> int:
    /*
    * Controlla se la CPU ha SVE2. Su x86_64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    if has_sve() == 0:
        return 0
    if id_reg_field(read_id_aa64zfr0_el1(), ID_AA64ZFR0_SVEVER, 4) == 0:
        return 0
    return 1


def has_aes() -> int:
    /*
    * Controlla se la CPU ha le istruzioni AES (AES-NI su x86_64).
    * return: 1 se supportato, 0 altrimenti
    */
    if id_reg_field(read_id_aa64isar0_el1(), ID_AA64ISAR0_AES, 4) == 0:
        return 0
    return 1


def has_rdrand() -> int:
    /*
    * Controlla se la CPU ha un generatore di numeri casuali in hardware:
    * RDRAND su x86_64, RNDR su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    if id_reg_field(read_id_aa64isar0_el1(), ID_AA64ISAR0_RNDR, 4) == 0:
        return 0
    return 1


def has_popcnt() -> int:
    /*
    * Controlla se la CPU conta i bit di una parola in un'istruzione: POPCNT
    * su x86_64, CNT di NEON su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    return has_neon()


def has_fma() -> int:
    /*
    * Controlla se la CPU ha la moltiplicazione e somma fuse: FMA3 su x86_64,
    * FMADD (virgola mobile di base) su aarch64.
    * return: 1 se supportato, 0 altrimenti
    */
    if id_reg_field(read_id_aa64pfr0_el1(), ID_AA64PFR0_FP, 4) == ID_FIELD_ABSENT:
        return 0
    return 1



// le estensioni di x86_64: su aarch64 non ci sono

def has_mmx() -> int:
    /*
    * Controlla se la CPU supporta MMX. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    return 0


