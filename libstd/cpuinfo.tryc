def has_sse42() -> int:
    /*
    * Controlla se la CPU supporta SSE4.2. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_SSE42
        cmp ecx, 0
        setne al
        movzx rax, al
