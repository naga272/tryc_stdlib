
/*
*   Standard library per ottenere informazioni sulla CPU. Le stesse
*   funzioni su x86_64 e su aarch64: cpu_vendor, cpu_brand, cpu_family,
*   cpu_model, cpu_stepping, cpu_cache_line_size, physical_address_bits,
*   virtual_address_bits, logical_cpu_count, is_hypervisor e le has_*.
*   Le has_* delle estensioni di un'architettura sull'altra restituiscono
*   0 (has_avx2 su aarch64, has_sve2 su x86_64).
*   Solo x86_64: cpuid (CpuidResult), rdmsr, wrmsr.
*   Solo aarch64: le letture dei registri ID (read_midr_el1, ...).
*   Non viene usata da nessuna parte l'heap memory
*/

#if not defined(__x86_64__) and not defined(__aarch64__)
    #pragma error "libstd/cpuinfo: architettura non supportata"
#endif

#include <libstd/type>


#ifdef __x86_64__

/*
*   x86_64: l'istruzione CPUID (identificazione/funzionalita' hardware) e
*   la syscall sched_getaffinity (quante CPU logiche sono disponibili al
*   processo corrente).
*/

#ifndef SYS_SCHED_GETAFFINITY
#define SYS_SCHED_GETAFFINITY 204
#endif

/* CPUID leaf usati dalla libreria */

#ifndef CPUID_LEAF_VENDOR
#define CPUID_LEAF_VENDOR 0
#endif

#ifndef CPUID_LEAF_FEATURES
#define CPUID_LEAF_FEATURES 1
#endif

#ifndef CPUID_LEAF_EXT_FEATURES
#define CPUID_LEAF_EXT_FEATURES 7
#endif

#ifndef CPUID_LEAF_EXT_MAX
#define CPUID_LEAF_EXT_MAX 2147483648   // 0x80000000
#endif

#ifndef CPUID_LEAF_BRAND_1
#define CPUID_LEAF_BRAND_1 2147483650   // 0x80000002
#endif

#ifndef CPUID_LEAF_BRAND_2
#define CPUID_LEAF_BRAND_2 2147483651   // 0x80000003
#endif

#ifndef CPUID_LEAF_BRAND_3
#define CPUID_LEAF_BRAND_3 2147483652   // 0x80000004
#endif

#ifndef CPUID_LEAF_ADDRESS_SIZES
#define CPUID_LEAF_ADDRESS_SIZES 2147483656   // 0x80000008
#endif


/* CPUID leaf 1, EDX (baseline di x86-64) */
#ifndef CPUID_EDX_FPU
// 1 << 0
#define CPUID_EDX_FPU 1
#endif

#ifndef CPUID_EDX_MMX
// 1 << 23
#define CPUID_EDX_MMX 8388608
#endif

#ifndef CPUID_EDX_SSE
// 1 << 25
#define CPUID_EDX_SSE 33554432
#endif

#ifndef CPUID_EDX_SSE2
// 1 << 26
#define CPUID_EDX_SSE2 67108864
#endif

#ifndef CPUID_EDX_HTT
// 1 << 28 (hyper-threading supportato, non significa che e' attivo)
#define CPUID_EDX_HTT 268435456
#endif

/* CPUID leaf 1, ECX */
#ifndef CPUID_ECX_SSE3
// 1 << 0
#define CPUID_ECX_SSE3 1
#endif

#ifndef CPUID_ECX_SSSE3
// 1 << 9
#define CPUID_ECX_SSSE3 512
#endif

#ifndef CPUID_ECX_FMA
// 1 << 12
#define CPUID_ECX_FMA 4096
#endif

#ifndef CPUID_ECX_SSE41
// 1 << 19
#define CPUID_ECX_SSE41 524288
#endif

#ifndef CPUID_ECX_SSE42
// 1 << 20
#define CPUID_ECX_SSE42 1048576
#endif

#ifndef CPUID_ECX_POPCNT
// 1 << 23
#define CPUID_ECX_POPCNT 8388608
#endif

#ifndef CPUID_ECX_AES
// 1 << 25
#define CPUID_ECX_AES 33554432
#endif

#ifndef CPUID_ECX_AVX
// 1 << 28
#define CPUID_ECX_AVX 268435456
#endif

#ifndef CPUID_ECX_RDRAND
// 1 << 30
#define CPUID_ECX_RDRAND 1073741824
#endif

#ifndef CPUID_ECX_HYPERVISOR
// 1 << 31 (il processo gira dentro una VM)
#define CPUID_ECX_HYPERVISOR  2147483648
#endif

/* CPUID leaf 7, subleaf 0, EBX */
#ifndef CPUID_LEAF7_EBX_AVX2
// 1 << 5
#define CPUID_LEAF7_EBX_AVX2 32
#endif

#ifndef CPUID_LEAF7_EBX_AVX512F
// 1 << 16
#define CPUID_LEAF7_EBX_AVX512F 65536
#endif


class CpuidResult --no-padding:
    eax int
    ebx int
    ecx int
    edx int


def cpuid(leaf: int, subleaf: int, out: CpuidResult) -> None:
    /*
    * Esegue l'istruzione CPUID e scrive EAX, EBX, ECX ed EDX in out. Solo
    * x86_64.
    * argomenti:
    *   leaf: il valore di EAX, cioe' la funzione richiesta
    *   subleaf: il valore di ECX, 0 se il leaf non lo usa
    *   out: dove scrivere i registri
    * return: nessuno (procedura)
    */
    asminline(
        push rbx
        mov r8, rdx
        mov eax, edi
        mov ecx, esi
        cpuid
        mov [r8], eax
        mov [r8 + 4], ebx
        mov [r8 + 8], ecx
        mov [r8 + 12], edx
        pop rbx
    ) endasm


def cpu_vendor() -> str:
    /*
    * Restituisce il produttore della CPU: su x86_64 la stringa di CPUID (es.
    * "GenuineIntel", "AuthenticAMD"), su aarch64 chi ha progettato il core
    * (es. "ARM", "Qualcomm", "Apple").
    * return: il nome; su aarch64, con un codice sconosciuto, "Unknown
    *   implementer. Num " seguito dal codice
    */
    asminline(
        push rbx
        mov rdi, 13
        call rt_alloc
        mov r8, rax

        mov eax, CPUID_LEAF_VENDOR
        xor ecx, ecx
        cpuid

        mov [r8], ebx
        mov [r8 + 4], edx
        mov [r8 + 8], ecx

        mov rax, r8


        pop rbx
    ) endasm


def cpu_brand() -> str:
    /*
    * Restituisce il nome completo della CPU: su x86_64 la stringa di CPUID
    * (es. "Intel(R) Core(TM) i7-9700K CPU @ 3.60GHz", anche con spazi finali),
    * su aarch64 produttore e core (es. "ARM Cortex-A72", "Qualcomm part
    * 0x804").
    * return: il nome
    */
    asminline(
        push rbx
        mov rdi, 49
        call rt_alloc
        mov r8, rax

        mov eax, CPUID_LEAF_BRAND_1
        xor ecx, ecx
        cpuid
        mov [r8], eax
        mov [r8 + 4], ebx
        mov [r8 + 8], ecx
        mov [r8 + 12], edx

        mov eax, CPUID_LEAF_BRAND_2
        xor ecx, ecx
        cpuid
        mov [r8 + 16], eax
        mov [r8 + 20], ebx
        mov [r8 + 24], ecx
        mov [r8 + 28], edx

        mov eax, CPUID_LEAF_BRAND_3
        xor ecx, ecx
        cpuid
        mov [r8 + 32], eax
        mov [r8 + 36], ebx
        mov [r8 + 40], ecx
        mov [r8 + 44], edx

        mov rax, r8


        pop rbx
    ) endasm


def cpu_family() -> int:
    /*
    * Restituisce la famiglia della CPU: su x86_64 la family di CPUID (con
    * la extended family), su aarch64 il codice di chi ha progettato il core
    * (MIDR_EL1.Implementer: 65 ARM, 81 Qualcomm, 97 Apple...).
    * return: il numero
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid

        mov r8d, eax
        shr r8d, 8
        and r8d, 0xF

        cmp r8d, 0xF
        jne .done
            mov r9d, eax
            shr r9d, 20
            and r9d, 0xFF
            add r8d, r9d
        .done:

        mov rax, r8
        pop rbx
    ) endasm


def cpu_model() -> int:
    /*
    * Restituisce il modello della CPU: su x86_64 il model di CPUID (con
    * l'extended model), su aarch64 il part number del core (MIDR_EL1.PartNum,
    * es. 3336 per Cortex-A72).
    * return: il numero
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid

        mov r8d, eax
        shr r8d, 8
        and r8d, 0xF

        mov r9d, eax
        shr r9d, 4
        and r9d, 0xF

        cmp r8d, 6
        je .use_extended
        cmp r8d, 0xF
        je .use_extended
        jmp .done

        .use_extended:
            mov r10d, eax
            shr r10d, 16
            and r10d, 0xF
            shl r10d, 4
            or r9d, r10d
        .done:

        mov rax, r9
        pop rbx
    ) endasm


def cpu_stepping() -> int:
    /*
    * Restituisce la revisione della CPU: su x86_64 lo stepping di CPUID, su
    * aarch64 la revisione rNpM del core come N * 16 + M.
    * return: il numero
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        mov r8d, eax
        and r8d, 0xF
        mov rax, r8
        pop rbx
    ) endasm


def cpu_cache_line_size() -> int:
    /*
    * Restituisce la dimensione di una linea di cache (su aarch64 la linea
    * dati piu' piccola).
    * return: i byte
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        mov r8d, ebx
        shr r8d, 8
        and r8d, 0xFF
        shl r8d, 3
        mov rax, r8
        pop rbx
    ) endasm


def physical_address_bits() -> int:
    /*
    * Restituisce quanti bit usa la CPU per gli indirizzi fisici (2^n byte
    * di memoria indirizzabile). Su aarch64 il dato non si legge da user
    * space.
    * return: i bit, -1 su aarch64
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_ADDRESS_SIZES
        xor ecx, ecx
        cpuid
        mov r8d, eax
        and r8d, 0xFF
        mov rax, r8
        pop rbx
    ) endasm


def virtual_address_bits() -> int:
    /*
    * Restituisce quanti bit usa la CPU per gli indirizzi virtuali. Su
    * aarch64 il dato non si legge da user space.
    * return: i bit, -1 su aarch64
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_ADDRESS_SIZES
        xor ecx, ecx
        cpuid
        mov r8d, eax
        shr r8d, 8
        and r8d, 0xFF
        mov rax, r8
        pop rbx
    ) endasm


def logical_cpu_count() -> int:
    /*
    * Restituisce quante CPU logiche puo' usare il processo
    * (sched_getaffinity).
    * return: il numero di CPU
    */
    asminline(
        push rbx
        mov rdi, 128
        call rt_alloc
        mov rbx, rax
        xor rdi, rdi
        mov rsi, 128
        mov rdx, rbx
        mov rax, SYS_SCHED_GETAFFINITY
        syscall

        xor r8, r8
        xor r9, r9

        .byte_loop:
            cmp r9, 128
            jge .done

            movzx r10, byte [rbx + r9]
            .count_bits:
                test r10, r10
                jz .next_byte
                mov r11, r10
                dec r11
                and r10, r11
                inc r8
                jmp .count_bits
            .next_byte:
            inc r9
            jmp .byte_loop

        .done:
        mov rax, r8
        pop rbx
    ) endasm


def has_sse2() -> int:
    /*
    * Controlla se la CPU supporta SSE2. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and edx, CPUID_EDX_SSE2
        cmp edx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_sse3() -> int:
    /*
    * Controlla se la CPU supporta SSE3. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_SSE3
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


def has_ssse3() -> int:
    /*
    * Controlla se la CPU supporta SSSE3. Su aarch64 restituisce 0.
    * return: 1 se supportato, 0 altrimenti
    */
    asminline(
        push rbx
        mov eax, CPUID_LEAF_FEATURES
        xor ecx, ecx
        cpuid
        and ecx, CPUID_ECX_SSSE3
        cmp ecx, 0
        setne al
        movzx rax, al
        pop rbx
    ) endasm


