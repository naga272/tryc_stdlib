
#ifdef __aarch64__
#define SYS_FUTEX 98
#else
#define SYS_FUTEX 202
#endif


#ifndef FUTEX_WAIT
#define FUTEX_WAIT 0
#endif


#ifndef FUTEX_WAKE
#define FUTEX_WAKE 1
#endif


#ifndef WAKE_UP_ALL
#define WAKE_UP_ALL 2147483647
#endif


def sys_futex_wait(addr: str, expected: int) -> int:
    /*
    * Addormenta il thread, se la word a 32 bit in addr vale ancora
    * expected, finche' un altro non lo sveglia con sys_futex_wake (syscall
    * futex). Puo' tornare anche senza sveglia: la condizione va ricontrollata
    * in un ciclo.
    * argomenti:
    *   addr: l'indirizzo della word
    *   expected: il valore che la word deve avere per addormentarsi
    * return: 0 se svegliato, negativo altrimenti (es. la word era gia'
    *   cambiata)
    */
#ifdef __aarch64__
    asminline(
        mov w2, w1
        mov x1, FUTEX_WAIT
        mov x3, 0
        mov x4, 0
        mov x5, 0
        mov x8, SYS_FUTEX
        svc #0
    ) endasm
#else
    asminline(
        mov edx, esi
        mov esi, FUTEX_WAIT
        xor r10, r10
        xor r8, r8
        xor r9, r9
        mov rax, SYS_FUTEX
        syscall
    )endasm
#endif


def sys_futex_wake(addr: str, num_waiters: int) -> int:
    /*
    * Sveglia fino a num_waiters thread addormentati con sys_futex_wait sullo
    * stesso indirizzo (syscall futex).
    * argomenti:
    *   addr: l'indirizzo della word
    *   num_waiters: quanti thread svegliare al massimo, WAKE_UP_ALL per tutti
    * return: quanti thread sono stati svegliati
    */
#ifdef __aarch64__
    asminline(
        mov w2, w1
        mov x1, FUTEX_WAKE
        mov x3, 0
        mov x4, 0
        mov x5, 0
        mov x8, SYS_FUTEX
        svc #0
    ) endasm
#else
    asminline(
        mov edx, esi
        mov esi, FUTEX_WAKE
        xor r10, r10
        xor r8, r8
        xor r9, r9
        mov rax, SYS_FUTEX
        syscall
    )endasm
#endif
