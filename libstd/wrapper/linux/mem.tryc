
/*
* Le costanti per mappare memoria con mmap, mprotect e munmap da un
* asminline (vedi wrapper/linux/systhread): solo Linux, su Windows la
* memoria passa da VirtualAlloc. I flag di open e i permessi sono in
* wrapper/linux/sysfile.
*/

#ifdef __aarch64__
#define SYS_MMAP 222
#define SYS_MPROTECT 226
#define SYS_MUNMAP 215
#define SYS_BRK 214
#else
#define SYS_MMAP 9
#define SYS_MPROTECT 10
#define SYS_MUNMAP 11
#define SYS_BRK 12
#endif

// flags per mmap
#ifndef MAP_PRIVATE
#define MAP_PRIVATE     2       // Cambi locali, niente sync su file
#endif

#ifndef MAP_ANONYMOUS
#define MAP_ANONYMOUS   32      // Nessun file backing (solo RAM)
#endif

#ifndef MAP_STACK
#define MAP_STACK       131072  // Allocazione ottimizzata per stack
#endif

#ifndef MAP_GROWSDOWN
#define MAP_GROWSDOWN   256     // Stack cresce verso indirizzi bassi
#endif


// FLAGS X MEM PROT
#ifndef PROT_READ
#define PROT_READ       1
#endif

#ifndef PROT_WRITE
#define PROT_WRITE      2
#endif

#ifndef PROT_EXEC
#define PROT_EXEC       4
#endif

#ifndef PROT_NONE
#define PROT_NONE       0
#endif
